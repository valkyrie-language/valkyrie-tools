using package::pkg;
using package::test;
using package::test::runner;

using compiler::ast::lexer::Lexer;
using compiler::ast::parser::Parser;
using compiler::ast::expansion::MacroExpander;
using compiler::hir::semantic::SemanticAnalyzer;
using compiler::hir::lowering::HirLowering;
using compiler::hir::typecheck::TypeChecker;
using compiler::mir_compiler::MirCompiler;
using compiler::mir_interpreter::MirInterpreter;
using compiler::mir_codegen_c::CodegenC;
using compiler::mir_codegen_wasm::CodegenWasm;
using compiler::mir_codegen_jvm::CodegenJvm;
using compiler::pkg::PackageManager;
using compiler::test::TestRunner;
using std::os::args;

println("Hello from VCC");
println("Starting...");

println("Calling args()...");
let cli_args = get_args();
println("Args len: ", cli_args.len());
let path = "../../test/test_cli.vk"; # Default
let child_args = [];
let mode = "run";
let target = "jvm";

if cli_args.len() > 0 {
    println("Processing args...");
    let i = 0;
    while i < cli_args.len() {
        println("Arg", i, ": ", cli_args[i]);
        if cli_args[i] == "--target" {
            if (i + 1) < cli_args.len() {
                target = cli_args[i+1];
            }
        }
        i = i + 1;
    }
    
    # Heuristic to find the actual command
     let cmd_index = 0;
     if cli_args.len() > 0 {
         if cli_args[0] == "run" {
             cmd_index = 0;
         } else if cli_args[0] == "build" {
             cmd_index = 0;
         }
     }
    
    if cmd_index < cli_args.len() {
        let arg0 = cli_args[cmd_index];
        println("Command Arg: ", arg0);
        
        if arg0 == "test" {
            mode = "test";
            if cli_args.len() > (cmd_index + 1) {
                path = cli_args[cmd_index + 1];
            }
        } else if arg0 == "build" {
            mode = "build";
            if cli_args.len() > (cmd_index + 1) {
                path = cli_args[cmd_index + 1];
            }
        } else {
            path = arg0;
            # Check if explicit run/build was passed earlier
            if cli_args[0] == "build" { mode = "build"; }
            
            # Extract child args
            let j = cmd_index + 1;
            let len = cli_args.len();
            while j < len {
                child_args.push(cli_args[j]);
                j = j + 1;
            }
        }
    }
}

println("Bootstrapping: Parsing test file...");
println("Path:", path);

# Calculate base_dir from path
let base_dir = "";
let i = path.len() - 1;
let chars = path.chars();
let found_sep = false;
let sep_idx = 0;
while i >= 0 {
    let c = chars[i];
    if c == "/" {
        found_sep = true;
        sep_idx = i;
        i = 0 - 1; # Break
    } else if c == "\\" {
        found_sep = true;
        sep_idx = i;
        i = 0 - 1; # Break
    } else {
        i = i - 1;
    }
}
if found_sep {
    # Manual substring: 0 to sep_idx
    let j = 0;
    while j < sep_idx {
        base_dir = base_dir + chars[j];
        j = j + 1;
    }
}
println("Base Dir:", base_dir);

let src = read_file(path);
println("Source length:", src.len());

# Read package name from legion.toml
let legion_path = "legion.toml";
println("Loading Manifest: ", legion_path);

let pkg_manager = new PackageManager(legion_path);
pkg_manager.resolve_dependencies();

let all_statements = [];

# Load dependencies (e.g. std)
let std_sources = pkg_manager.get_package_sources("std");
if std_sources.len() > 0 {
    println("Loading std sources: ", std_sources.len());
    let i = 0;
    let len = std_sources.len();
    while i < len {
        let path = std_sources[i];
        let inner_src = read_file(path);
        if inner_src != null {
            let lexer = new Lexer(inner_src);
            # Package name for std files is "std"
            let parser = new Parser(lexer, "std", path);
            let prog = parser.parse_program();
            if parser.errors.len() > 0 {
                println("Error parsing std file: ", path);
                let j = 0;
                let elen = parser.errors.len();
                while j < elen {
                    let e = parser.errors[j];
                    println(e.msg, " at line ", e.line);
                    j = j + 1;
                }
                exit(1);
            }
            
            let stmts = prog.statements;
            let j = 0;
            let slen = stmts.len();
            while j < slen {
                all_statements.push(stmts[j]);
                j = j + 1;
            }
        } else {
             println("Warning: Failed to read std file: ", path);
        }
        i = i + 1;
    }
}

let package_name = "bootstrap";
if pkg_manager.root_manifest != null {
    package_name = pkg_manager.root_manifest.name;
    println("Package Name: ", package_name);
}

println("Parsing program...");
let lexer = new Lexer(src);
let parser = new Parser(lexer, package_name, path);
let user_program = parser.parse_program();

if parser.errors.len() > 0 {
    println("Parsing failed with ", parser.errors.len(), " errors.");
    let i = 0;
    let len = parser.errors.len();
    while i < len {
        let e = parser.errors[i];
        println(e.msg, " at line ", e.line);
        i = i + 1;
    }
    println("Aborting compilation.");
    exit(1);
}

println("Expanding macros...");
let expander = new MacroExpander(base_dir, package_name);
let user_program_expanded = expander.expand_program(user_program);
if expander.errors.len() > 0 {
    println("Macro expansion failed.");
    let i = 0;
    let len = expander.errors.len();
    while i < len {
        println(expander.errors[i]);
        i = i + 1;
    }
    exit(1);
}
let stmts = user_program_expanded.statements;
let j = 0;
let slen = stmts.len();
while j < slen {
    all_statements.push(stmts[j]);
    j = j + 1;
}

# Create merged program
        using compiler::ast::Program;
        let final_program = new Program(all_statements, user_program.span);

        println("Parsing complete.");
        
        println("Lowering to HIR...");
        let lowering = new HirLowering();
        let hir_program = lowering.lower(final_program);
        println("Lowering complete.");
        
        println("Running Semantic Analysis...");
        let analyzer = new SemanticAnalyzer();
        analyzer.analyze(hir_program);
        # println("Semantic Analysis complete.");

        println("Running Type Checking...");
        let type_checker = new TypeChecker(analyzer.symbols, path);
        type_checker.check(hir_program);
        if type_checker.diagnostics.len() > 0 {
             println("Type checking failed with ", type_checker.diagnostics.len(), " errors.");
             exit(1);
        }
        
        println("Generating MIR...");
        let compiler = new MirCompiler();
        let mir_program = compiler.compile(hir_program);
        println("MIR Generation complete.");
        
        if mode == "run" {
            println("Interpreting...");
            let interpreter = new MirInterpreter();
            interpreter.set_args(child_args);
            interpreter.run(mir_program);
        } else if mode == "test" {
            println("Running Tests...");
             let runner = new TestRunner();
             runner.run_tests(mir_program);
        } else if mode == "build" {
            println("Building for target: ", target);
            if target == "wasm" {
                println("Generating WASM binary...");
                let codegen = new CodegenWasm();
                let bytes = codegen.compile(mir_program);
                
                # Determine output name from path
                let out_name = "output.wasm";
                
                write_file_bytes(out_name, bytes);
                println("Built to ", out_name);
            } else if target == "c" {
                println("Generating C code...");
                let codegen = new CodegenC();
                let code = codegen.compile(mir_program);
                let out_name = "output.c";
                write_file(out_name, code);
                println("Built to ", out_name);
            } else if target == "jvm" {
                println("Generating JVM Jasmin assembly...");
                let codegen = new CodegenJvm();
                let code = codegen.compile(mir_program);
                let out_name = "Output.j";
                write_file(out_name, code);
                println("Built to ", out_name);
            } else {
                println("Unknown target: ", target);
                exit(1);
            }
        }
