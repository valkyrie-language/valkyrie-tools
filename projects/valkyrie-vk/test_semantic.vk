let x: i32 = 10;
let y: i32 = 20;
if lt(x, y) {
    println("x < y");
} else {
    println("x >= y");
}

class Point {
    x: i32,
    y: i32
    micro constructor(self, x: i32, y: i32) {
        self.x = x;
        self.y = y;
    }
    micro show(self) {
        println("Point");
    }
}

let p: Point = new Point(100, 200);
p.show();
println(p.x);
println(p.y);
