namespace compiler::mir_codegen_wasm;

using compiler::mir::OpCode;
using compiler::mir::MirProgram;

class CodegenWasm {
    bytes: List
    
    micro constructor(self) {
        self.bytes = [];
    }
    
    micro emit_byte(self, b) {
        self.bytes.push(b);
    }
    
    micro emit_bytes(self, list) {
        let i = 0;
        let len = list.len();
        while i < len {
            self.bytes.push(list[i]);
            i = i + 1;
        }
    }
    
    micro emit_u32(self, v) {
        # LEB128 unsigned
        let loop_cond = true;
        let val = v;
        while loop_cond {
            let byte = val & 127; # 0x7F
            val = val / 128; # >> 7
            if val == 0 {
                self.emit_byte(byte);
                loop_cond = false;
            } else {
                self.emit_byte(byte | 128); # 0x80
            }
        }
    }
    
    micro emit_i64(self, v) {
        # LEB128 signed
        let loop_cond = true;
        let val = v;
        while loop_cond {
            let byte = val & 127;
            val = val / 128;
            # Sign bit of byte is 2nd bit (0x40)
            let sign_bit = byte & 64;
            
            if (val == 0 && sign_bit == 0) || (val == -1 && sign_bit != 0) {
                 self.emit_byte(byte);
                 loop_cond = false;
            } else {
                 self.emit_byte(byte | 128);
            }
        }
    }
    
    micro emit_string(self, s) {
        self.emit_u32(s.len());
        let chars = s.chars();
        let i = 0;
        let len = chars.len();
        while i < len {
             # Naive char to byte (ASCII only for now)
             # TODO: UTF-8 encoding
             let c = chars[i];
             # We don't have char_to_byte in std yet? 
             # Let's assume we can cast or simple mapping for now.
             # Actually we need `char_to_int` or something.
             # In interpreter, chars are strings of length 1.
             # Let's rely on a helper or assume ASCII.
             # Temporary hack: we don't encode string content correctly if it's not ascii.
             # We'll just push 0 for now or skip?
             # Wait, `vcc` needs to emit strings for exports.
             # Host `int()` can parse string to int, but not char code.
             # Let's use a lookup or just assume we have a way.
             # Actually, for "main" and "print", we can hardcode bytes.
             # "main" -> [109, 97, 105, 110]
             # "print" -> [112, 114, 105, 110, 116]
             # "env" -> [101, 110, 118]
             if s == "main" { self.emit_bytes([109, 97, 105, 110]); }
             else if s == "print" { self.emit_bytes([112, 114, 105, 110, 116]); }
             else if s == "env" { self.emit_bytes([101, 110, 118]); }
             else {
                 # Fallback: emit '?'
                 self.emit_byte(63);
             }
             i = i + 1;
        }
    }
    
    micro compile(self, program) {
        self.bytes = [];
        
        # Magic: \0asm
        self.emit_bytes([0, 97, 115, 109]);
        # Version: 1
        self.emit_bytes([1, 0, 0, 0]);
        
        # Section 1: Type
        self.emit_byte(1);
        let type_section = new CodegenWasm();
        type_section.emit_u32(2); # count
        
        # Type 0: (i64) -> ()  (for print)
        type_section.emit_byte(96); # func
        type_section.emit_u32(1); # 1 param
        type_section.emit_byte(126); # i64
        type_section.emit_u32(0); # 0 results
        
        # Type 1: () -> () (for main)
        type_section.emit_byte(96); # func
        type_section.emit_u32(0); # 0 params
        type_section.emit_u32(0); # 0 results
        
        self.emit_u32(type_section.bytes.len());
        self.emit_bytes(type_section.bytes);
        
        # Section 2: Import
        self.emit_byte(2);
        let import_section = new CodegenWasm();
        import_section.emit_u32(1); # count
        import_section.emit_string("env");
        import_section.emit_string("print");
        import_section.emit_byte(0); # func kind
        import_section.emit_u32(0); # type index 0
        
        self.emit_u32(import_section.bytes.len());
        self.emit_bytes(import_section.bytes);
        
        # Section 3: Function
        self.emit_byte(3);
        let func_section = new CodegenWasm();
        func_section.emit_u32(1); # count
        func_section.emit_u32(1); # type index 1 (main)
        
        self.emit_u32(func_section.bytes.len());
        self.emit_bytes(func_section.bytes);
        
        # Section 7: Export
        self.emit_byte(7);
        let export_section = new CodegenWasm();
        export_section.emit_u32(1); # count
        export_section.emit_string("main");
        export_section.emit_byte(0); # func export
        export_section.emit_u32(1); # func index 1 (0 is import)
        
        self.emit_u32(export_section.bytes.len());
        self.emit_bytes(export_section.bytes);
        
        # Section 10: Code
        self.emit_byte(10);
        let code_section = new CodegenWasm();
        code_section.emit_u32(1); # count
        
        # Body for main
        let body = new CodegenWasm();
        
        # Locals
        # Scan for max local
        let max_local = -1;
        let i = 0;
        let len = program.instructions.len();
        let loop_cond = true;
        while loop_cond {
            if i >= len { loop_cond = false; } else {
                let instr = program.instructions[i];
                if instr.kind == "LoadLocal" {
                    if instr.index > max_local { max_local = instr.index; }
                } else if instr.kind == "StoreLocal" {
                    if instr.index > max_local { max_local = instr.index; }
                }
                i = i + 1;
            }
        }
        
        if max_local >= 0 {
             body.emit_u32(1); # 1 group of locals
             body.emit_u32(max_local + 1); # count
             body.emit_byte(126); # i64
        } else {
             body.emit_u32(0); # 0 locals
        }
        
        # Instructions
        i = 0;
        loop_cond = true;
        while loop_cond {
            if i >= len { loop_cond = false; } else {
                let instr = program.instructions[i];
                body.emit_instruction(instr);
                i = i + 1;
            }
        }
        body.emit_byte(11); # end
        
        code_section.emit_u32(body.bytes.len());
        code_section.emit_bytes(body.bytes);
        
        self.emit_u32(code_section.bytes.len());
        self.emit_bytes(code_section.bytes);
        
        return self.bytes;
    }
    
    micro emit_instruction(self, instr) {
        let k = instr.kind;
        if k == "PushInt" {
            self.emit_byte(66); # i64.const
            self.emit_i64(instr.value);
        } else if k == "PushBool" {
            self.emit_byte(66);
            if instr.value { self.emit_i64(1); } else { self.emit_i64(0); }
        } else if k == "PushVoid" {
            self.emit_byte(66);
            self.emit_i64(0);
        } else if k == "Add" {
            self.emit_byte(124); # i64.add
        } else if k == "Sub" {
            self.emit_byte(125); # i64.sub
        } else if k == "Mul" {
            self.emit_byte(126); # i64.mul
        } else if k == "Div" {
            self.emit_byte(127); # i64.div_s
        } else if k == "Eq" {
            self.emit_byte(81); # i64.eq
        } else if k == "Neq" {
            self.emit_byte(82); # i64.ne
        } else if k == "Lt" {
            self.emit_byte(72); # i64.lt_s
        } else if k == "Gt" {
            self.emit_byte(74); # i64.gt_s
        } else if k == "Le" {
            self.emit_byte(73); # i64.le_s
        } else if k == "Ge" {
            self.emit_byte(75); # i64.ge_s
        } else if k == "Print" {
            self.emit_byte(16); # call
            self.emit_u32(0); # func index 0 (print)
        } else if k == "StoreLocal" {
            self.emit_byte(33); # local.set
            self.emit_u32(instr.index);
        } else if k == "LoadLocal" {
            self.emit_byte(32); # local.get
            self.emit_u32(instr.index);
        } else if k == "Pop" {
            self.emit_byte(26); # drop
        } else {
            # Ignore or trap
        }
    }
}
