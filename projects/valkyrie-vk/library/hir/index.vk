    span: Span
    
    micro constructor(self, left, op, right, span) {
        self.left = left;
        self.op = op;
        self.right = right;
        self.span = span;
        self.kind = "HirBinary";
    }

    micro accept(self, visitor) {
        return visitor.visit_binary(self);
    }
}

