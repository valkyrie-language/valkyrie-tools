namespace compiler::ast::lexer;

class Token {
    kind: String,
    value: String,
    line: i32,
    col: i32

    micro constructor(self, kind, value, line, col) {
        self.kind = kind;
        self.value = value;
        self.line = line;
        self.col = col;
    }
}

class Lexer {
    src: String,
    len: i32,
    pos: i32,
    chars: List,
    line: i32,
    col: i32

    micro constructor(self, src) {
        self.src = src;
        self.chars = src.chars();
        self.len = src.len();
        self.pos = 0;
        self.line = 1;
        self.col = 1;
    }

    micro next_token(self) -> Token {
        while self.pos < self.len {
            let c = self.chars[self.pos];
            let start_line = self.line;
            let start_col = self.col;
            
            if c == " " {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
            } else if c == "\n" {
                self.pos = self.pos + 1;
                self.line = self.line + 1;
                self.col = 1;
            } else if c == "\r" {
                self.pos = self.pos + 1;
            } else if c == "\t" {
                self.pos = self.pos + 1;
                self.col = self.col + 4;
            } else if c == "=" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                if self.pos < self.len {
                    let next_c = self.chars[self.pos];
                    if next_c == "=" {
                        self.pos = self.pos + 1;
                        self.col = self.col + 1;
                        return new Token("EqualEqual", "==", start_line, start_col);
                    }
                }
                return new Token("Equal", "=", start_line, start_col);
            } else if c == ";" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("Semi", ";", start_line, start_col);
            } else if c == "(" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("ParenL", "(", start_line, start_col);
            } else if c == ")" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("ParenR", ")", start_line, start_col);
            } else if c == "{" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("BraceL", "{", start_line, start_col);
            } else if c == "}" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("BraceR", "}", start_line, start_col);
            } else if c == "[" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("BracketL", "[", start_line, start_col);
            } else if c == "]" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("BracketR", "]", start_line, start_col);
            } else if c == ":" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                if self.pos < self.len {
                    let next_c = self.chars[self.pos];
                    if next_c == ":" {
                        self.pos = self.pos + 1;
                        self.col = self.col + 1;
                        return new Token("DoubleColon", "::", start_line, start_col);
                    }
                }
                return new Token("Colon", ":", start_line, start_col);
            } else if c == "," {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("Comma", ",", start_line, start_col);
            } else if c == "." {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("Dot", ".", start_line, start_col);
            } else if c == "!" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                if self.pos < self.len {
                    let next_c = self.chars[self.pos];
                    if next_c == "=" {
                        self.pos = self.pos + 1;
                        self.col = self.col + 1;
                        return new Token("Neq", "!=", start_line, start_col);
                    }
                }
                return new Token("Bang", "!", start_line, start_col);
            } else if c == "-" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                if self.pos < self.len {
                     let next_c = self.chars[self.pos];
                     if next_c == ">" {
                         self.pos = self.pos + 1;
                         self.col = self.col + 1;
                         return new Token("Arrow", "->", start_line, start_col);
                     }
                }
                return new Token("Minus", "-", start_line, start_col);
            } else if c == "/" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("Slash", "/", start_line, start_col);
            } else if c == "%" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("Percent", "%", start_line, start_col);
            } else if c == "<" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                if self.pos < self.len {
                     let next_c = self.chars[self.pos];
                     if next_c == "=" {
                         self.pos = self.pos + 1;
                         self.col = self.col + 1;
                         return new Token("LessEqual", "<=", start_line, start_col);
                     }
                }
                return new Token("Less", "<", start_line, start_col);
            } else if c == ">" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                if self.pos < self.len {
                     let next_c = self.chars[self.pos];
                     if next_c == "=" {
                         self.pos = self.pos + 1;
                         self.col = self.col + 1;
                         return new Token("GreaterEqual", ">=", start_line, start_col);
                     }
                }
                return new Token("Greater", ">", start_line, start_col);
            } else if c == "&" {
                 self.pos = self.pos + 1;
                 self.col = self.col + 1;
                 if self.pos < self.len {
                     let next_c = self.chars[self.pos];
                     if next_c == "&" {
                         self.pos = self.pos + 1;
                         self.col = self.col + 1;
                         return new Token("And", "&&", start_line, start_col);
                     }
                 }
                 return new Token("BitAnd", "&", start_line, start_col);
            } else if c == "|" {
                 self.pos = self.pos + 1;
                 self.col = self.col + 1;
                 if self.pos < self.len {
                     let next_c = self.chars[self.pos];
                     if next_c == "|" {
                         self.pos = self.pos + 1;
                         self.col = self.col + 1;
                         return new Token("Or", "||", start_line, start_col);
                     }
                 }
                 return new Token("BitOr", "|", start_line, start_col);
            } else if c == "@" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("At", "@", start_line, start_col);
            } else if c == "+" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("Plus", "+", start_line, start_col);
            } else if c == "*" {
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                return new Token("Star", "*", start_line, start_col);
            } else if c == "#" {
                let loop_cond = true;
                while loop_cond {
                    if self.pos >= self.len {
                        loop_cond = false;
                    } else {
                        let next_c = self.chars[self.pos];
                        if next_c == "\n" {
                            loop_cond = false;
                        } else {
                            self.pos = self.pos + 1;
                        }
                    }
                }
            } else if c == "\"" {
                self.pos = self.pos + 1; # skip opening quote
                self.col = self.col + 1;
                let val = "";
                let loop_cond = true;
                while loop_cond {
                    if self.pos >= self.len {
                        loop_cond = false; # Error: unclosed string
                    } else {
                        let next_c = self.chars[self.pos];
                        if next_c == "\"" {
                            self.pos = self.pos + 1; # skip closing quote
                            self.col = self.col + 1;
                            loop_cond = false;
                        } else {
                            val = val + next_c;
                            self.pos = self.pos + 1;
                            self.col = self.col + 1;
                            if next_c == "\n" {
                                self.line = self.line + 1;
                                self.col = 1;
                            }
                        }
                    }
                }
                return new Token("String", val, start_line, start_col);
            } else {
                let val = "";
                val = val + c;
                self.pos = self.pos + 1;
                self.col = self.col + 1;
                
                let loop_cond = true;
                while loop_cond {
                    if self.pos >= self.len {
                        loop_cond = false;
                    } else {
                        let next_c = self.chars[self.pos];
                        if next_c == " " { loop_cond = false; }
                        else if next_c == "\n" { loop_cond = false; }
                        else if next_c == "\r" { loop_cond = false; }
                        else if next_c == "\t" { loop_cond = false; }
                        else if next_c == "=" { loop_cond = false; }
                        else if next_c == ";" { loop_cond = false; }
                        else if next_c == "(" { loop_cond = false; }
                        else if next_c == ")" { loop_cond = false; }
                        else if next_c == "{" { loop_cond = false; }
                        else if next_c == "}" { loop_cond = false; }
                        else if next_c == "[" { loop_cond = false; }
                        else if next_c == "]" { loop_cond = false; }
                        else if next_c == ":" { loop_cond = false; }
                        else if next_c == "," { loop_cond = false; }
                        else if next_c == "." { loop_cond = false; }
                        else if next_c == "-" { loop_cond = false; }
                        else if next_c == "/" { loop_cond = false; }
                        else if next_c == "%" { loop_cond = false; }
                        else if next_c == "<" { loop_cond = false; }
                        else if next_c == ">" { loop_cond = false; }
                        else if next_c == "&" { loop_cond = false; }
                        else if next_c == "|" { loop_cond = false; }
                        else {
                            val = val + next_c;
                            self.pos = self.pos + 1;
                            self.col = self.col + 1;
                        }
                    }
                }
                
                if val == "match" { return new Token("Match", val, start_line, start_col); }
                if val == "let" { return new Token("Let", val, start_line, start_col); }
                if val == "namespace" { return new Token("Namespace", val, start_line, start_col); }
                if val == "using" { return new Token("Using", val, start_line, start_col); }
                if val == "micro" { return new Token("Micro", val, start_line, start_col); }
                if val == "class" { return new Token("Class", val, start_line, start_col); }
                if val == "return" { return new Token("Return", val, start_line, start_col); }
                if val == "if" { return new Token("If", val, start_line, start_col); }
                if val == "else" { return new Token("Else", val, start_line, start_col); }
                if val == "while" { return new Token("While", val, start_line, start_col); }
                if val == "new" { return new Token("New", val, start_line, start_col); }
                if val == "true" { return new Token("Boolean", val, start_line, start_col); }
                if val == "false" { return new Token("Boolean", val, start_line, start_col); }
                
                return new Token("IdentOrNum", val, start_line, start_col);
            }
        }
        return new Token("EOF", "", self.line, self.col);
    }
}
