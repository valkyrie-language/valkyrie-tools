// Valkyrie 语言词法分析器
// Token 类型枚举
let TokenType = {
    // 字面量
    STRING: "STRING",
    NUMBER: "NUMBER",
    BOOLEAN: "BOOLEAN",
    
    // 标识符和关键字
    IDENTIFIER: "IDENTIFIER",
    LET: "LET",
    MICRO: "MICRO",
    IF: "IF",
    ELSE: "ELSE",
    RETURN: "RETURN",
    TRUE: "TRUE",
    FALSE: "FALSE",
    
    // 运算符
    ASSIGN: "ASSIGN",
    PLUS: "PLUS",
    MINUS: "MINUS",
    MULTIPLY: "MULTIPLY",
    DIVIDE: "DIVIDE",
    MODULO: "MODULO",
    
    // 比较运算符
    EQUAL: "EQUAL",
    NOT_EQUAL: "NOT_EQUAL",
    LESS_THAN: "LESS_THAN",
    LESS_EQUAL: "LESS_EQUAL",
    GREATER_THAN: "GREATER_THAN",
    GREATER_EQUAL: "GREATER_EQUAL",
    
    // 逻辑运算符
    AND: "AND",
    OR: "OR",
    NOT: "NOT",
    
    // 分隔符
    SEMICOLON: "SEMICOLON",
    COMMA: "COMMA",
    DOT: "DOT",
    
    // 括号
    LEFT_PAREN: "LEFT_PAREN",
    RIGHT_PAREN: "RIGHT_PAREN",
    LEFT_BRACE: "LEFT_BRACE",
    RIGHT_BRACE: "RIGHT_BRACE",
    LEFT_BRACKET: "LEFT_BRACKET",
    RIGHT_BRACKET: "RIGHT_BRACKET",
    
    // 特殊
    EOF: "EOF",
    NEWLINE: "NEWLINE"
};

// Token 类
micro Token(type, value, line, column) {
    return {
        type: type,
        value: value,
        line: line,
        column: column
    };
}

// 词法分析器类
micro Lexer(source) {
    let self = {
        source: source,
        position: 0,
        line: 1,
        column: 1,
        current: source.length > 0 ? source[0] : null
    };
    
    // 关键字映射
    let keywords = {
        "let": TokenType.LET,
        "micro": TokenType.MICRO,
        "if": TokenType.IF,
        "else": TokenType.ELSE,
        "return": TokenType.RETURN,
        "true": TokenType.TRUE,
        "false": TokenType.FALSE
    };
    
    // 前进一个字符
    let advance = micro() {
        if (self.current === "\n") {
            self.line = self.line + 1;
            self.column = 1;
        } else {
            self.column = self.column + 1;
        }
        
        self.position = self.position + 1;
        if (self.position >= self.source.length) {
            self.current = null;
        } else {
            self.current = self.source[self.position];
        }
    };
    
    // 跳过空白字符
    let skipWhitespace = micro() {
        while (self.current !== null && (self.current === " " || self.current === "\t" || self.current === "\r")) {
            advance();
        }
    };
    
    // 跳过注释
    let skipComment = micro() {
        if (self.current === "/" && self.position + 1 < self.source.length && self.source[self.position + 1] === "/") {
            while (self.current !== null && self.current !== "\n") {
                advance();
            }
        }
    };
    
    // 读取字符串
    let readString = micro() {
        let value = "";
        advance(); // 跳过开始的引号
        
        while (self.current !== null && self.current !== "\"") {
            if (self.current === "\\") {
                advance();
                if (self.current === "n") {
                    value = value + "\n";
                } else if (self.current === "t") {
                    value = value + "\t";
                } else if (self.current === "r") {
                    value = value + "\r";
                } else if (self.current === "\\") {
                    value = value + "\\";
                } else if (self.current === "\"") {
                    value = value + "\"";
                } else {
                    value = value + self.current;
                }
            } else {
                value = value + self.current;
            }
            advance();
        }
        
        if (self.current === "\"") {
            advance(); // 跳过结束的引号
        }
        
        return value;
    };
    
    // 读取数字
    let readNumber = micro() {
        let value = "";
        let hasDot = false;
        
        while (self.current !== null && (isDigit(self.current) || (self.current === "." && !hasDot))) {
            if (self.current === ".") {
                hasDot = true;
            }
            value = value + self.current;
            advance();
        }
        
        return value;
    };
    
    // 读取标识符
    let readIdentifier = micro() {
        let value = "";
        
        while (self.current !== null && (isAlphaNumeric(self.current) || self.current === "_")) {
            value = value + self.current;
            advance();
        }
        
        return value;
    };
    
    // 检查是否为数字
    let isDigit = micro(char) {
        return char >= "0" && char <= "9";
    };
    
    // 检查是否为字母
    let isAlpha = micro(char) {
        return (char >= "a" && char <= "z") || (char >= "A" && char <= "Z");
    };
    
    // 检查是否为字母或数字
    let isAlphaNumeric = micro(char) {
        return isAlpha(char) || isDigit(char);
    };
    
    // 获取下一个 token
    let nextToken = micro() {
        while (self.current !== null) {
            let line = self.line;
            let column = self.column;
            
            // 跳过空白字符
            if (self.current === " " || self.current === "\t" || self.current === "\r") {
                skipWhitespace();
                continue;
            }
            
            // 处理换行
            if (self.current === "\n") {
                let token = Token(TokenType.NEWLINE, "\n", line, column);
                advance();
                return token;
            }
            
            // 跳过注释
            if (self.current === "/" && self.position + 1 < self.source.length && self.source[self.position + 1] === "/") {
                skipComment();
                continue;
            }
            
            // 字符串字面量
            if (self.current === "\"") {
                let value = readString();
                return Token(TokenType.STRING, value, line, column);
            }
            
            // 数字字面量
            if (isDigit(self.current)) {
                let value = readNumber();
                return Token(TokenType.NUMBER, value, line, column);
            }
            
            // 标识符和关键字
            if (isAlpha(self.current) || self.current === "_") {
                let value = readIdentifier();
                let type = keywords[value] || TokenType.IDENTIFIER;
                return Token(type, value, line, column);
            }
            
            // 双字符运算符
            if (self.current === "=" && self.position + 1 < self.source.length && self.source[self.position + 1] === "=") {
                advance();
                advance();
                return Token(TokenType.EQUAL, "==", line, column);
            }
            
            if (self.current === "!" && self.position + 1 < self.source.length && self.source[self.position + 1] === "=") {
                advance();
                advance();
                return Token(TokenType.NOT_EQUAL, "!=", line, column);
            }
            
            if (self.current === "<" && self.position + 1 < self.source.length && self.source[self.position + 1] === "=") {
                advance();
                advance();
                return Token(TokenType.LESS_EQUAL, "<=", line, column);
            }
            
            if (self.current === ">" && self.position + 1 < self.source.length && self.source[self.position + 1] === "=") {
                advance();
                advance();
                return Token(TokenType.GREATER_EQUAL, ">=", line, column);
            }
            
            if (self.current === "&" && self.position + 1 < self.source.length && self.source[self.position + 1] === "&") {
                advance();
                advance();
                return Token(TokenType.AND, "&&", line, column);
            }
            
            if (self.current === "|" && self.position + 1 < self.source.length && self.source[self.position + 1] === "|") {
                advance();
                advance();
                return Token(TokenType.OR, "||", line, column);
            }
            
            // 单字符 token
            let char = self.current;
            advance();
            
            if (char === "=") return Token(TokenType.ASSIGN, "=", line, column);
            if (char === "+") return Token(TokenType.PLUS, "+", line, column);
            if (char === "-") return Token(TokenType.MINUS, "-", line, column);
            if (char === "*") return Token(TokenType.MULTIPLY, "*", line, column);
            if (char === "/") return Token(TokenType.DIVIDE, "/", line, column);
            if (char === "%") return Token(TokenType.MODULO, "%", line, column);
            if (char === "<") return Token(TokenType.LESS_THAN, "<", line, column);
            if (char === ">") return Token(TokenType.GREATER_THAN, ">", line, column);
            if (char === "!") return Token(TokenType.NOT, "!", line, column);
            if (char === ";") return Token(TokenType.SEMICOLON, ";", line, column);
            if (char === ",") return Token(TokenType.COMMA, ",", line, column);
            if (char === ".") return Token(TokenType.DOT, ".", line, column);
            if (char === "(") return Token(TokenType.LEFT_PAREN, "(", line, column);
            if (char === ")") return Token(TokenType.RIGHT_PAREN, ")", line, column);
            if (char === "{") return Token(TokenType.LEFT_BRACE, "{", line, column);
            if (char === "}") return Token(TokenType.RIGHT_BRACE, "}", line, column);
            if (char === "[") return Token(TokenType.LEFT_BRACKET, "[", line, column);
            if (char === "]") return Token(TokenType.RIGHT_BRACKET, "]", line, column);
        }
        
        return Token(TokenType.EOF, null, self.line, self.column);
    };
    
    // 标记化整个源码
    let tokenize = micro() {
        let tokens = [];
        let token = nextToken();
        
        while (token.type !== TokenType.EOF) {
            if (token.type !== TokenType.NEWLINE) {
                tokens.push(token);
            }
            token = nextToken();
        }
        
        tokens.push(token); // 添加 EOF token
        return tokens;
    };
    
    return {
        nextToken: nextToken,
        tokenize: tokenize
    };
}