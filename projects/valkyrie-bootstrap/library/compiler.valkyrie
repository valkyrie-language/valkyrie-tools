# Valkyrie 语言编译器主模块

# 编译器类
micro ValkyrieCompiler() {
    let self = {
        lexer: null,
        parser: null,
        codegen: CodeGenerator()
    };
    
    # 编译源码
    let compile = micro(source, filename) {
        if (filename === undefined) {
            filename = "<unknown>";
        }
        
        # 词法分析
        self.lexer = Lexer(source);
        let tokens = self.lexer.tokenize();
        
        # 语法分析
        self.parser = Parser(tokens);
        let ast = self.parser.parseProgram();
        
        # 代码生成
        let jsCode = self.codegen.generate(ast);
        
        return {
            success: true,
            code: jsCode,
            ast: ast,
            tokens: tokens
        };
    };
    
    return {
        compile: compile
    };
}