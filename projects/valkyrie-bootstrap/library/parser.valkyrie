# Valkyrie Language Parser - 最小化版本

function ParseError(message) {
    let error = {}
    error.message = message
    error.name = "ParseError"
    return error
}

function Parser() {
    let parser = {}
    parser.tokens = []
    parser.current = 0
    
    parser.parse = function(tokens) {
        if tokens {
            parser.tokens = tokens
            parser.current = 0
        }
        
        let statements = []
        
        while !parser.isAtEnd() {
            let stmt = parser.declaration()
            if stmt {
                statements[statements.length] = stmt
            }
        }
        
        return statements
    }
    
    parser.peek = function() {
        if parser.current >= parser.tokens.length {
            return parser.tokens[parser.tokens.length - 1]
        }
        return parser.tokens[parser.current]
    }
    
    parser.previous = function() {
        return parser.tokens[parser.current - 1]
    }
    
    parser.isAtEnd = function() {
        return parser.peek().type == "EOF"
    }
    
    parser.advance = function() {
        if !parser.isAtEnd() {
            parser.current = parser.current + 1
        }
        return parser.previous()
    }
    
    parser.check = function(type) {
        if parser.isAtEnd() {
            return false
        }
        return parser.peek().type == type
    }
    
    parser.match = function(type) {
        if parser.check(type) {
            parser.advance()
            return true
        }
        return false
    }
    
    parser.consume = function(type, message) {
        if parser.check(type) {
            return parser.advance()
        }
        # 简化错误处理
        return parser.peek()
    }
    
    parser.declaration = function() {
        if parser.match("function") {
            return parser.functionDeclaration()
        }
        if parser.match("let") {
            return parser.variableDeclaration()
        }
        return parser.statement()
    }
    
    parser.functionDeclaration = function() {
        let name = parser.consume("IDENTIFIER", "Expected function name")
        
        parser.consume("(", "Expected '(' after function name")
        
        let params = []
        if !parser.check(")") {
            params[params.length] = parser.consume("IDENTIFIER", "Expected parameter name")
            while parser.match(",") {
                params[params.length] = parser.consume("IDENTIFIER", "Expected parameter name")
            }
        }
        
        parser.consume(")", "Expected ')' after parameters")
        parser.consume("{", "Expected '{' before function body")
        
        let body = []
        while !parser.check("}") && !parser.isAtEnd() {
            let stmt = parser.statement()
            if stmt {
                body[body.length] = stmt
            }
        }
        
        parser.consume("}", "Expected '}' after function body")
        
        let func = {}
        func.type = "FunctionDeclaration"
        func.name = name.value
        func.params = params
        func.body = body
        return func
    }
    
    parser.variableDeclaration = function() {
        let name = parser.consume("IDENTIFIER", "Expected variable name")
        
        let init = {}
        if parser.match("=") {
            init = parser.expression()
        }
        
        parser.match(";")
        
        let variable = {}
        variable.type = "VariableDeclaration"
        variable.name = name.value
        variable.init = init
        return variable
    }
    
    parser.statement = function() {
        if parser.match("if") {
            return parser.ifStatement()
        }
        if parser.match("while") {
            return parser.whileStatement()
        }
        if parser.match("for") {
            return parser.forStatement()
        }
        if parser.match("return") {
            return parser.returnStatement()
        }
        if parser.match("{") {
            return parser.blockStatement()
        }
        
        return parser.expressionStatement()
    }
    
    parser.ifStatement = function() {
        let condition = parser.expression()
        
        parser.consume("{", "Expected '{' after if condition")
        let thenBranch = parser.blockStatement()
        
        let elseBranch = {}
        if parser.match("else") {
            if parser.match("{") {
                elseBranch = parser.blockStatement()
            } else if parser.match("if") {
                elseBranch = parser.ifStatement()
            }
        }
        
        let ifStmt = {}
        ifStmt.type = "IfStatement"
        ifStmt.condition = condition
        ifStmt.thenBranch = thenBranch
        ifStmt.elseBranch = elseBranch
        return ifStmt
    }
    
    parser.whileStatement = function() {
        let condition = parser.expression()
        
        parser.consume("{", "Expected '{' after while condition")
        let body = parser.blockStatement()
        
        let whileStmt = {}
        whileStmt.type = "WhileStatement"
        whileStmt.condition = condition
        whileStmt.body = body
        return whileStmt
    }
    
    parser.forStatement = function() {
        let variable = parser.consume("IDENTIFIER", "Expected variable name")
        parser.consume("in", "Expected 'in' after for variable")
        let iterable = parser.expression()
        
        parser.consume("{", "Expected '{' after for expression")
        let body = parser.blockStatement()
        
        let forStmt = {}
        forStmt.type = "ForStatement"
        forStmt.variable = variable.value
        forStmt.iterable = iterable
        forStmt.body = body
        return forStmt
    }
    
    parser.returnStatement = function() {
        let value = {}
        if !parser.check(";") && !parser.check("}") {
            value = parser.expression()
        }
        
        parser.match(";")
        
        let returnStmt = {}
        returnStmt.type = "ReturnStatement"
        returnStmt.value = value
        return returnStmt
    }
    
    parser.blockStatement = function() {
        let statements = []
        
        while !parser.check("}") && !parser.isAtEnd() {
            let stmt = parser.declaration()
            if stmt {
                statements[statements.length] = stmt
            }
        }
        
        parser.consume("}", "Expected '}' after block")
        
        let block = {}
        block.type = "BlockStatement"
        block.statements = statements
        return block
    }
    
    parser.expressionStatement = function() {
        let expr = parser.expression()
        parser.match(";")
        
        let exprStmt = {}
        exprStmt.type = "ExpressionStatement"
        exprStmt.expression = expr
        return exprStmt
    }
    
    parser.expression = function() {
        return parser.assignment()
    }
    
    parser.assignment = function() {
        let expr = parser.logicalOr()
        
        if parser.match("=") {
            let value = parser.assignment()
            
            let assignment = {}
            assignment.type = "AssignmentExpression"
            assignment.left = expr
            assignment.right = value
            return assignment
        }
        
        return expr
    }
    
    parser.logicalOr = function() {
        let expr = parser.logicalAnd()
        
        while parser.match("||") {
            let operator = parser.previous()
            let right = parser.logicalAnd()
            
            let binary = {}
            binary.type = "BinaryExpression"
            binary.left = expr
            binary.operator = operator.value
            binary.right = right
            expr = binary
        }
        
        return expr
    }
    
    parser.logicalAnd = function() {
        let expr = parser.equality()
        
        while parser.match("&&") {
            let operator = parser.previous()
            let right = parser.equality()
            
            let binary = {}
            binary.type = "BinaryExpression"
            binary.left = expr
            binary.operator = operator.value
            binary.right = right
            expr = binary
        }
        
        return expr
    }
    
    parser.equality = function() {
        let expr = parser.comparison()
        
        while parser.match("==") || parser.match("!=") {
            let operator = parser.previous()
            let right = parser.comparison()
            
            let binary = {}
            binary.type = "BinaryExpression"
            binary.left = expr
            binary.operator = operator.value
            binary.right = right
            expr = binary
        }
        
        return expr
    }
    
    parser.comparison = function() {
        let expr = parser.term()
        
        while parser.match(">") || parser.match(">=") || parser.match("<") || parser.match("<=") {
            let operator = parser.previous()
            let right = parser.term()
            
            let binary = {}
            binary.type = "BinaryExpression"
            binary.left = expr
            binary.operator = operator.value
            binary.right = right
            expr = binary
        }
        
        return expr
    }
    
    parser.term = function() {
        let expr = parser.factor()
        
        while parser.match("-") || parser.match("+") {
            let operator = parser.previous()
            let right = parser.factor()
            
            let binary = {}
            binary.type = "BinaryExpression"
            binary.left = expr
            binary.operator = operator.value
            binary.right = right
            expr = binary
        }
        
        return expr
    }
    
    parser.factor = function() {
        let expr = parser.unary()
        
        while parser.match("/") || parser.match("*") {
            let operator = parser.previous()
            let right = parser.unary()
            
            let binary = {}
            binary.type = "BinaryExpression"
            binary.left = expr
            binary.operator = operator.value
            binary.right = right
            expr = binary
        }
        
        return expr
    }
    
    parser.unary = function() {
        if parser.match("!") || parser.match("-") {
            let operator = parser.previous()
            let right = parser.unary()
            
            let unary = {}
            unary.type = "UnaryExpression"
            unary.operator = operator.value
            unary.right = right
            return unary
        }
        
        return parser.call()
    }
    
    parser.call = function() {
        let expr = parser.primary()
        
        while true {
            if parser.match("(") {
                expr = parser.finishCall(expr)
            } else if parser.match(".") {
                let name = parser.consume("IDENTIFIER", "Expected property name after '.'")
                
                let member = {}
                member.type = "MemberExpression"
                member.object = expr
                member.property = name.value
                expr = member
            } else {
                return expr
            }
        }
        
        return expr
    }
    
    parser.finishCall = function(callee) {
        let args = []
        
        if !parser.check(")") {
            args[args.length] = parser.expression()
            while parser.match(",") {
                args[args.length] = parser.expression()
            }
        }
        
        parser.consume(")", "Expected ')' after arguments")
        
        let call = {}
        call.type = "CallExpression"
        call.callee = callee
        call.arguments = args
        return call
    }
    
    parser.primary = function() {
        if parser.match("true") {
            let literal = {}
            literal.type = "Literal"
            literal.value = true
            return literal
        }
        
        if parser.match("false") {
            let literal = {}
            literal.type = "Literal"
            literal.value = false
            return literal
        }
        
        if parser.match("INTEGER") {
            let literal = {}
            literal.type = "Literal"
            literal.value = parser.previous().value
            return literal
        }
        
        if parser.match("STRING") {
            let literal = {}
            literal.type = "Literal"
            literal.value = parser.previous().value
            return literal
        }
        
        if parser.match("IDENTIFIER") {
            let identifier = {}
            identifier.type = "Identifier"
            identifier.name = parser.previous().value
            return identifier
        }
        
        if parser.match("(") {
            let expr = parser.expression()
            parser.consume(")", "Expected ')' after expression")
            return expr
        }
        
        # 返回空对象作为错误处理
        let error = {}
        error.type = "Error"
        return error
    }
    
    return parser
}