{
    "name": "@valkyrie-language/valkyrie-bootstrap",
    "version": "0.0.0",
    "description": "Valkyrie language bootstrap compiler",
    "main": "dist/index.js",
    "type": "module",
    "bin": {
        "valkyrie": "./dist/index.js"
    },
    "scripts": {
        "dev": "vitepress dev",
        "build": "vitepress build",
        "preview": "vitepress preview",
        "test": "node test/test.js",
        "compile": "node valkyrie.js compile",
        "watch": "node valkyrie.js watch",
        "example": "node valkyrie.js compile -s examples -o dist/examples -v"
    },
    "keywords": [
        "valkyrie",
        "compiler",
        "bootstrap",
        "programming-language",
        "transpiler",
        "javascript"
    ],
    "author": "Valkyrie Language Team",
    "license": "ISC",
    "engines": {
        "node": ">=14.0.0"
    },
    "devDependencies": {}
}
